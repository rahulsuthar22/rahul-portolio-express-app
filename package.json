{
  "name": "portfolio-api",
  "version": "1.0.0",
  "description": "Production-grade portfolio backend API",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node --inspect dist/server.js",
    "typecheck": "tsc --noEmit",
    "contract:emit": "prisma contract emit",
    "create:admin": "tsx scripts/create-admin.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run tests/e2e",
    "test:unit": "vitest run tests/unit",
    "validate": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "portfolio",
    "express",
    "typescript",
    "node",
    "api"
  ],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@js-temporal/polyfill": "^0.5.1",
    "@prisma/orm-postgres": "^8.0.0-rc.8",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/coverage-v8": "^5.0.2",
    "openapi-types": "^12.1.3",
    "pino-pretty": "^13.2.0",
    "prisma": "^8.0.0-rc.13",
    "supertest": "^7.2.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
